# Python environments, build products and caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
.venv-eval/
venv/
*.egg-info/
build/
dist/
.coverage
htmlcov/

# Credentials and per-machine configuration
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
id_ed25519*
configs/*.local.json
configs/*.local.sh
configs/reze_evidence_plan_v1.json
configs/reze_evidence_fullval_v1.json
configs/automation_v1.json
scripts/merit-qvh-supervisor.service

# External datasets, weights and generated experiment output
/data/
/models/
/artifacts/
/runs/
/logs/
/runtime/
*.safetensors
*.ckpt
*.pt
*.pth
*.mp4
*.mkv
*.avi
*.webm
*.log
*.pid
.DS_Store

# Recreated on each machine; example templates and pinned revisions are tracked.
/baselines/zeroshot/manifests/*.json
/baselines/zeroshot/manifests/*.jsonl
!/baselines/zeroshot/manifests/*.example.json
/baselines/zeroshot/configs/protocol_v1.json
/baselines/zeroshot/results/
/baselines/zeroshot/artifacts/

# Reviewed historical logs belong to the frozen comparison archive.
!/comparisons/qvhighlights/**/*.log
