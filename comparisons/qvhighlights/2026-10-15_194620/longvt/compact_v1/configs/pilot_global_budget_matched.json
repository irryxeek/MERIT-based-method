{
  "seed": 42,
  "clip_seconds": 2,
  "score_min": 0.0,
  "score_max": 4.0,
  "global_max_frames": 66,
  "local_max_frames": 32,
  "max_pixels": 50176,
  "max_tool_calls": 2,
  "max_override_segments": 5,
  "max_output_tokens": 2048,
  "analysis_max_output_tokens": 768,
  "score_max_output_tokens": 512,
  "temperature": 0,
  "top_p": 1.0,
  "format_retries": 1,
  "save_local_frames": true,
  "generation_protocol": "unconstrained_evidence_analysis_then_background_and_local_time_overrides",
  "score_finalization_constraint": "none_strict_client_validation",
  "format_retry_constraint": "vllm_json_schema_background_and_max_5_local_time_overrides",
  "time_override_to_clip_rule": "clip_midpoint_in_half_open_interval_max_on_overlap",
  "deterministic_syntax_cleanup": [
    "remove_outer_markdown_fence",
    "append_one_missing_outer_object_brace_only_when_delimiter_counts_prove_it"
  ],
  "request_timeout_seconds": 1200,
  "failure_fallback": "all_zero",
  "smoke_size": 8,
  "pilot_size": 50,
  "download_candidate_reserve": 100,
  "download_workers": 4,
  "archive_extract_reserve": 20,
  "duration_tolerance_seconds": 1.1,
  "media_max_height": 480,
  "server_max_model_len": 65536,
  "budget_match_rule": "ceil(longvt_tool pilot mean total_read_frames 65.72) = 66 uniform global frames",
  "budget_match_uses_labels": false
}
